# NKOM Backend Environment Configuration
# Copy this file to .env and fill with your actual values
# CRITICAL: This file contains secrets - NEVER commit to git

# ============================================================================
# APPLICATION SECURITY
# ============================================================================
SECRET_KEY=your-secret-key-change-in-production-min-32-chars!
DEBUG=false
ENVIRONMENT=production

# CORS - adjust for your domain
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================================
# AUTHENTICATION & JWT
# ============================================================================
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# AWS COGNITO (from terraform output — leave empty to use legacy HS256 auth)
# ============================================================================
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# COGNITO_REGION defaults to AWS_REGION when not set

# ============================================================================
# DATABASE (PostgreSQL from Terraform/RDS)
# ============================================================================
POSTGRES_USER=nkom_admin
POSTGRES_PASSWORD=SecureP@ssw0rd!2024
POSTGRES_HOST=nkom-postgres.xxxxx.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=nkom

# ============================================================================
# CACHE (Redis from Terraform/ElastiCache)
# ============================================================================
REDIS_HOST=nkom-redis.xxxxx.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=RedisAuth!Token@2024
REDIS_SSL=true

# ============================================================================
# AI & CONTENT GENERATION (Claude API)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# CLOUD STORAGE (AWS S3 from Terraform)
# ============================================================================
AWS_REGION=us-east-1
S3_BUCKET_NAME=nkom-user-uploads-123456789
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Use IAM roles if running on EC2/ECS (recommended for production)
USE_IAM_ROLES=false

# ============================================================================
# FILE UPLOAD SECURITY
# ============================================================================
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=pdf,txt,doc,docx,jpg,jpeg,png,mp3,wav,m4a

# ============================================================================
# RATE LIMITING & ABUSE PREVENTION
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
LOG_LEVEL=INFO
SENTRY_DSN=
CLOUDWATCH_LOGS_ENABLED=false
APM_ENABLED=false

# ============================================================================
# FEATURES
# ============================================================================
ENABLE_WHISPER=true
ENABLE_PDF_EXTRACTION=true
ENABLE_OCR=false
