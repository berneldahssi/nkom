# ── NKOM Frontend Environment ─────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Values marked [terraform] come from: cd infrastructure/terraform && AWS_PROFILE=nkom terraform output

# ── Backend API ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NKOM

# ── Cognito Auth [terraform] ──────────────────────────────────────
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_COGNITO_DOMAIN=nkom-auth-production.auth.us-east-1.amazoncognito.com
