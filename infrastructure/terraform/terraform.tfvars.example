# NKOM Infrastructure — copy to terraform.tfvars and fill in secrets.
# terraform.tfvars is git-ignored; never commit it.
#
# Run:
#   AWS_PROFILE=nkom terraform init
#   AWS_PROFILE=nkom terraform plan
#   AWS_PROFILE=nkom terraform apply

# ── General ───────────────────────────────────────────────────────
project_name = "nkom"
environment  = "production"
aws_region   = "us-east-1"

# ── Cost toggles ─────────────────────────────────────────────────
# Start with both off to minimize monthly cost.
# Redis:     enable when you need caching / Celery workers (~$13/mo)
# KMS:       enable when you need customer-managed encryption (~$3/mo)
enable_redis           = false
enable_kms_custom_keys = false

# ── Database ─────────────────────────────────────────────────────
db_instance_class = "db.t3.micro"  # Free tier eligible for 12 months
db_name           = "nkom"

# Credentials — generate strong values:
#   python3 -c "import secrets,string; print(secrets.token_urlsafe(12))"  # username
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"         # password
db_username = "nkom_admin"
db_password = "REPLACE_ME_min16chars_Aa1!"

# ── Redis (only used when enable_redis = true) ────────────────────
redis_node_type  = "cache.t3.micro"
redis_auth_token = "REPLACE_ME_min16chars_Aa1!"

# ── Backups ───────────────────────────────────────────────────────
backup_retention_days = 7

# ── Monitoring ────────────────────────────────────────────────────
alert_email = "your@email.com"
